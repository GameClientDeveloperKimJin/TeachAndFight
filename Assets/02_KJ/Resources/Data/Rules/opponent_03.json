{
  "version": 1,
  "fighter_name": "그림자",
  "max_slots": 10,
  "rules": [
    { "id": "rule_01", "label": "강공 낌새엔 회피 대시", "when": [ { "fact": "enemy_action", "op": "==", "value": "heavy_startup" } ], "do": { "action": "dash", "params": { "direction": "away" } }, "priority": 9 },
    { "id": "rule_02", "label": "헛치면 강공 처벌", "when": [ { "fact": "enemy_action", "op": "==", "value": "whiff_recovery" }, { "fact": "distance", "op": "<=", "value": 1.5 } ], "do": { "action": "heavy_attack" }, "priority": 8 },
    { "id": "rule_03", "label": "궁 반격", "when": [ { "fact": "self_ult_gauge", "op": ">=", "value": 100 } ], "do": { "action": "ultimate" }, "priority": 8 },
    { "id": "rule_04", "label": "저스태미나 휴식", "when": [ { "fact": "self_stamina_pct", "op": "<", "value": 30 } ], "do": { "action": "idle" }, "priority": 6 },
    { "id": "rule_05", "label": "중거리 유지", "when": [ { "fact": "distance", "op": ">=", "value": 0 } ], "do": { "action": "keep_distance", "params": { "range": 2.5 } }, "priority": 4 }
  ]
}
