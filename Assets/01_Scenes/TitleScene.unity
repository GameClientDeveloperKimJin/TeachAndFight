    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.25
  m_Text: "1. \uD6C8\uB828 (Training)\n   \uC81C\uC790\uC5D0\uAC8C \"\uB9D0\"\uB85C
    \uC804\uC220\uC744 \uAC00\uB974\uCE5C\uB2E4.\n   \uC608) \"\uCCB4\uB825\uC774
    \uC808\uBC18 \uBC11\uC774\uBA74 \uBC29\uC5B4\uD574\", \"\uAC70\uB9AC\uAC00 \uBA40\uBA74
    \uC811\uADFC\uD574\"\n\n2. \uACBD\uAE30 (Match)\n   \uAC00\uB974\uCE5C \uADDC\uCE59\uB300\uB85C
    \uC81C\uC790\uAC00 \uC2A4\uC2A4\uB85C \uC2F8\uC6B4\uB2E4.\n   \uACBD\uAE30 \uC911
    \uC9C1\uC811 \uC870\uC791\uC740 \uBD88\uAC00. \uBC30\uC18D/\uC77C\uC2DC\uC815\uC9C0\uB9CC
    \uAC00\uB2A5\uD558\uB2E4.\n\n3. \uB77C\uCEE4\uB8F8 (Locker Room)\n   \uACBD\uAE30\uB97C
    \uBCF5\uAE30\uD558\uACE0, \uB2E4\uC74C \uD6C8\uB828\uC5D0\uC11C \uADDC\uCE59\uC744
    \uACE0\uCCD0 \uB2E4\uC2DC \uB3C4\uC804\uD55C\uB2E4.\n\n\uBAA9\uD45C : \uC0C1\uB300\uC758
    \uD328\uD134\uC744 \uC77D\uACE0, \uC774\uAE30\uB294 \uADDC\uCE59\uC744 \uB9CC\uB4E4\uC5B4\uB77C."
